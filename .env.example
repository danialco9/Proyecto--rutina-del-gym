# Optional for `docker compose up` (it has local defaults); required for running the API with uv.
# Copy to .env and adjust. Never commit .env.
POSTGRES_DB=gym_tracker
POSTGRES_USER=gym
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
# Host ports for the Docker Compose API and web app.
API_PORT=8000
WEB_PORT=8080

# Backend API
GYM_DATABASE_URL=postgresql+psycopg://gym:change-me@localhost:5432/gym_tracker
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
GYM_JWT_SECRET=change-me-to-a-long-random-string
# Keep true in production (HTTPS); false only for local http development.
GYM_COOKIE_SECURE=false
# Login and registration rate limits. memory:// works for one instance; use redis://host:6379 for several.
GYM_RATE_LIMIT_ENABLED=true
GYM_RATE_LIMIT_STORAGE=memory://
# IANA time zone for calendar days and weeks in the progress analytics.
GYM_TIMEZONE=Europe/Madrid
